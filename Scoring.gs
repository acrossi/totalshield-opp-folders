/** Diagnostic: why owners show as Unassigned. Counts PRODUCTION/CLOSED_PROJECTS opps with no
 * resolvable assignee, split into "no assignee in Copper" vs stale assignee ids, and looks up
 * each stale id by direct GET /users/{id} to name the former user. */
function auditUnassignedOwners() {
  var opps = copperSearchOpportunities_({}).filter(function (o) {
    var b = bucketForOpp_(o);
    return b === 'PRODUCTION' || b === 'CLOSED_PROJECTS';
  });
  var active = copperUsers_().byId;
  var noAssignee = 0, stale = {};
  opps.forEach(function (o) {
    if (o.assignee_id && active[o.assignee_id]) return;
    if (!o.assignee_id) { noAssignee++; return; }
    stale[o.assignee_id] = (stale[o.assignee_id] || 0) + 1;
  });
  var names = {};
  Object.keys(stale).forEach(function (id) {
    var u = null;
    try { u = copperRequest_('GET', '/users/' + id); } catch (e) {}
    names[id] = (u ? u.name + ' <' + u.email + '>' : 'lookup failed') + ' x' + stale[id];
  });
  Logger.log(JSON.stringify({ no_assignee_in_copper: noAssignee, stale_assignee_ids: names }));
}

/** Diagnostic: infer likely owners for unassigned PRODUCTION/CLOSED_PROJECTS opportunities from
 * Copper activity authors and Drive file last-modifying users. Writes the "Owner Inference" tab;
 * changes nothing in Copper or Drive. Suggestion prefers the top non-Adam Copper activity author,
 * then the top non-Adam Drive editor, then falls back to whoever leads overall. */
function inferUnassignedOwners() {
  var opps = copperSearchOpportunities_({}).filter(function (o) {
    var b = bucketForOpp_(o);
    return (b === 'PRODUCTION' || b === 'CLOSED_PROJECTS') && !o.assignee_id;
  });
  var userCache = {};
  function userName_(id) {
    if (!userCache[id]) {
      var u = copperUsers_().byId[id];
      if (!u) { try { u = copperRequest_('GET', '/users/' + id); } catch (e) {} }
      userCache[id] = (u && u.name) ? u.name : ('user ' + id);
    }
    return userCache[id];
  }
  var token = ScriptApp.getOAuthToken();
  function driveVotes_(folderId, acc, depth) {
    if (depth > 3) return;
    var pageToken = '';
    do {
      var url = 'https://www.googleapis.com/drive/v3/files?q=' +
        encodeURIComponent("'" + folderId + "' in parents and trashed=false") +
        '&fields=' + encodeURIComponent('nextPageToken,files(id,name,mimeType,lastModifyingUser(displayName,emailAddress))') +
        '&pageSize=200&supportsAllDrives=true&includeItemsFromAllDrives=true' +
        (pageToken ? '&pageToken=' + pageToken : '');
      var res = JSON.parse(UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + token }, muteHttpExceptions: true }).getContentText());
      (res.files || []).forEach(function (f) {
        if (f.mimeType === 'application/vnd.google-apps.folder') { driveVotes_(f.id, acc, depth + 1); return; }
        if (f.name && isReportFile_(f.name)) return;
        var u = f.lastModifyingUser;
        var key = u ? (u.displayName || u.emailAddress || 'unknown') : 'unknown';
        acc[key] = (acc[key] || 0) + 1;
      });
      pageToken = res.nextPageToken || '';
    } while (pageToken);
  }
  function fmt_(acc) {
    return Object.keys(acc).sort(function (a, b) { return acc[b] - acc[a]; })
      .map(function (k) { return k + ':' + acc[k]; }).join(', ');
  }
  function top_(acc, skipAdam) {
    var best = '', n = 0;
    Object.keys(acc).forEach(function (k) {
      if (skipAdam && k.indexOf('Adam') === 0) return;
      if (k === 'unknown') return;
      if (acc[k] > n) { n = acc[k]; best = k; }
    });
    return best;
  }
  var sheet = planSheet_('Owner Inference');
  sheet.clearContents();
  sheet.appendRow(['opp_id', 'folder', 'copper activity votes', 'drive file votes', 'suggestion']);
  var rows = [];
  opps.forEach(function (o) {
    var cv = {};
    try {
      var acts = copperRequest_('POST', '/activities/search', { parent: { type: 'opportunity', id: o.id }, page_size: 200 }) || [];
      acts.forEach(function (a) { if (a.user_id) { var n = userName_(a.user_id); cv[n] = (cv[n] || 0) + 1; } });
    } catch (e) {}
    var dv = {}, folder = null;
    try { folder = findOppFolder_(o); if (folder) driveVotes_(folder.getId(), dv, 0); } catch (e) {}
    var sug = top_(cv, true) || top_(dv, true) || top_(cv) || top_(dv) || '?';
    rows.push([o.id, folder ? folder.getName() : '(no folder)', fmt_(cv), fmt_(dv), sug]);
    if (rows.length >= 10) { appendRows_(sheet, rows); rows = []; }
  });
  if (rows.length) appendRows_(sheet, rows);
  Logger.log('Owner inference done: ' + opps.length + ' opportunities -> "Owner Inference" tab');
}

/** One-time: create the "Historical Owner" text custom field on opportunities (no-op if present). */

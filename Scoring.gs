/** Install the nightly 3 AM scoreReportAll batch (rescores all PRODUCTION/CLOSED_PROJECTS folders,
 * refreshes every report doc, the log tabs, and the "Documentation Scores by Owner" doc). The
 * trigger id is stored so chunk cleanup never deletes it. Safe to re-run: replaces any previous one. */
function installNightlyScoreTrigger() {
  var props = PropertiesService.getScriptProperties();
  var prev = props.getProperty('NIGHTLY_SCORE_TRIGGER_ID');
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'scoreReportAll' && t.getUniqueId() === prev) { try { ScriptApp.deleteTrigger(t); } catch (e) {} }
  });
  var t = ScriptApp.newTrigger('scoreReportAll').timeBased().atHour(3).everyDays(1).inTimezone(CONFIG.TIMEZONE).create();
  props.setProperty('NIGHTLY_SCORE_TRIGGER_ID', t.getUniqueId());
  Logger.log('Nightly score batch trigger installed (3 AM ' + CONFIG.TIMEZONE + ')');
}

/** Utility: abandon a stuck batch report. */
function resetScoreReportState() {
  PropertiesService.getScriptProperties().deleteProperty('SCORE_RPT_STATE');
  cleanupScoreTriggers_();
}


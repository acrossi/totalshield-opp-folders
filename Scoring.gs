/**
 * Scoring.gs - documentation quality score for a completed opportunity.
 *
 * Inventories the standard subfolders and scores against CONFIG.SCORING.
 * Writes the score to Copper (CF_DOC_SCORE) and a breakdown row to the "score" log sheet.
 */

/**
 * Pure scoring. inventory = {subfolderName: {count, types: [FILE_TYPES keys matched]}, ...}
 * (a bare number is accepted for count, with no type info). Returns {score, raw, max, breakdown[]}.
 * A folder with needTypes earns nothing until every requirement group is satisfied by at least one
 * file matching one of its alternatives; bonus folders add capped credit only.
 */
function computeScore_(inventory, looseFiles) {
  var rubric = CONFIG.SCORING;
  var score = 0, max = 0, breakdown = [];
  Object.keys(rubric).forEach(function (name) {
    var r = rubric[name];
    var inv = inventory[name];
    var count = typeof inv === 'number' ? inv : (inv ? inv.count : 0);
    var types = (inv && inv.types) || [];
    if (!r.bonus) max += r.weight;
    var missing = (r.needTypes || []).filter(function (group) {
      return !group.some(function (t) { return types.indexOf(t) !== -1; });
    });
    var pts = 0, note = '';
    if (missing.length) {
      pts = 0;
      if (count > 0) note = ' (no ' + missing.map(function (g) { return g.join('|'); }).join(', no ') + ')';
    } else if (count >= r.minFiles) {
      pts = r.weight;
    } else if (count > 0) {
      pts = Math.round(r.weight * (count / r.minFiles));
    }
    score += pts;
    breakdown.push(name + ':' + count + '=' + pts + (r.bonus ? 'b' : '') + note);
  });
  var penalty = Math.min(CONFIG.LOOSE_FILE_PENALTY_CAP, (looseFiles || 0) * CONFIG.LOOSE_FILE_PENALTY);
  score = Math.max(0, score - penalty);
  if (penalty) breakdown.push('loose_files:' + looseFiles + '=-' + penalty);
  return { score: Math.min(100, Math.round(100 * score / max)), raw: score, max: max, breakdown: breakdown };
}

/** True for report docs generated by this script, under the current or any earlier name. */
function isReportFile_(name) {
  var prefixes = [CONFIG.REPORT_PREFIX].concat(CONFIG.LEGACY_REPORT_PREFIXES || []);
  return prefixes.some(function (p) { return String(name || '').indexOf(p) === 0; });
}

/** True when a file (name, mimeType) matches a FILE_TYPES entry. */
function fileMatchesType_(typeKey, name, mime) {
  var t = CONFIG.FILE_TYPES[typeKey];
  if (!t) return false;
  return !!((t.ext && t.ext.test(name || '')) || (t.mime && t.mime.test(mime || '')));
}

/**
 * Count files (recursively) per subfolder with the FILE_TYPES each contains, plus loose files at the root.
 * Each subfolder entry also carries files[] ({path, name, mime, url, updated, types}) for the report's
 * file listing; rootFiles holds the loose root files (score reports excluded). Scoring ignores files[].
 */
function inventoryFolder_(folder) {
  var inv = {}, loose = 0, rootFiles = [];
  var files = folder.getFiles();
  while (files.hasNext()) {
    var rf = files.next();
    if (isReportFile_(rf.getName())) continue;
    loose++;
    rootFiles.push(fileEntry_(rf, '', folder.getUrl()));
  }
  var subs = folder.getFolders();
  while (subs.hasNext()) {
    var sf = subs.next();
    var acc = { count: 0, types: [], files: [], url: sf.getUrl() };
    collectFiles_(sf, 0, acc, '');
    inv[sf.getName()] = acc;
  }
  return { inventory: inv, loose: loose, rootFiles: rootFiles };
}

function collectFiles_(folder, depth, acc, relPath) {
  if (depth > 5) return;
  var files = folder.getFiles();
  var dirUrl = files.hasNext() && acc.files ? folder.getUrl() : '';
  while (files.hasNext()) {
    var f = files.next();
    acc.count++;
    var e = fileEntry_(f, relPath || '', dirUrl);
    e.types.forEach(function (k) { if (acc.types.indexOf(k) === -1) acc.types.push(k); });
    if (acc.files) acc.files.push(e);
  }
  var subs = folder.getFolders();
  while (subs.hasNext()) {
    var sub = subs.next();
    collectFiles_(sub, depth + 1, acc, (relPath ? relPath + '/' : '') + sub.getName());
  }
}

/** Listing entry for one Drive file; types = FILE_TYPES keys it matches. */
function fileEntry_(f, relPath, dirUrl) {
  var name = f.getName(), mime = f.getMimeType();
  return {
    path: relPath, name: name, mime: mime, url: f.getUrl(), dirUrl: dirUrl || '', updated: f.getLastUpdated(),
    types: Object.keys(CONFIG.FILE_TYPES).filter(function (k) { return fileMatchesType_(k, name, mime); })
  };
}

/* ---------------- File listing (pure, unit-tested) ---------------- */

var SHORT_TYPE_LABELS_ = { solidworks: 'SolidWorks', pdf: 'PDF', word: 'Word', gdoc: 'Google Doc', gsheet: 'Google Sheet', excel: 'Excel' };
var GOOGLE_MIME_LABELS_ = { presentation: 'Google Slides', drawing: 'Google Drawing', form: 'Google Form', shortcut: 'Shortcut', folder: 'Folder', site: 'Google Site' };

/** Short human type for one listed file: rubric type if matched, else Google type, else the extension. */
function fileTypeLabel_(e) {
  if (e.types && e.types.length) return SHORT_TYPE_LABELS_[e.types[0]] || e.types[0];
  var g = /^application\/vnd\.google-apps\.(\w+)/.exec(e.mime || '');
  if (g) return GOOGLE_MIME_LABELS_[g[1]] || 'Google ' + g[1];
  var x = /\.([A-Za-z0-9]{1,6})$/.exec(e.name || '');
  if (x) return x[1].toUpperCase();
  if (/^image\//.test(e.mime || '')) return 'Image';
  return 'Other';
}

/** Whether one file helps the score, in words, given the folder it sits in. */
function fileCreditNote_(folderName, e) {
  if (folderName === null) return 'No: loose file at folder root, move into a numbered folder';
  var r = CONFIG.SCORING[folderName];
  if (!r) {
    if (CONFIG.SUBFOLDERS.indexOf(folderName) !== -1) return 'Not scored';
    return 'No: not a standard folder, move into a numbered folder';
  }
  if (r.bonus) return 'Yes (bonus)';
  var groups = r.needTypes || [];
  if (!groups.length) return 'Yes';
  var hit = groups.filter(function (g) { return g.some(function (t) { return (e.types || []).indexOf(t) !== -1; }); });
  if (hit.length) return 'Yes';
  return 'No: not a required type (' + groups.map(function (g) { return g.map(function (t) { return SHORT_TYPE_LABELS_[t] || t; }).join(' or '); }).join(' and ') + ')';
}

/**
 * Group the inventory into listing sections for the report, in standard folder order, then any
 * non-standard subfolders (alphabetical), then loose root files. At most `cap` rows overall.
 * Returns {groups: [{folder, name, label, url, total, rows: [[File, Type, Modified, Counts]], links: [{file, dir, dirLen}]}], listed, total, omitted}.
 * links[i].dirLen is the length of the "path/" prefix in the File cell, linked to the containing folder (dir).
 * `fmtDate` formats a Date (injected so the function stays pure for tests).
 */
function buildFileListing_(inventory, rootFiles, cap, fmtDate, rootUrl) {
  cap = cap || CONFIG.REPORT_FILE_LIST_CAP || 300;
  fmtDate = fmtDate || function (d) { return d ? String(d) : ''; };
  var tops = CONFIG.SUBFOLDERS.filter(function (s) { return s.indexOf('/') === -1; });
  var extra = Object.keys(inventory).filter(function (n) { return tops.indexOf(n) === -1; }).sort();
  var order = tops.filter(function (n) { return inventory[n]; }).concat(extra);
  var sections = order.map(function (n) { return { folder: n, url: (inventory[n] && inventory[n].url) || '', files: (inventory[n] && inventory[n].files) || [] }; });
  if (rootFiles && rootFiles.length) sections.push({ folder: null, url: rootUrl || '', files: rootFiles });

  var listed = 0, total = 0, groups = [];
  sections.forEach(function (s) {
    var r = s.folder === null ? null : CONFIG.SCORING[s.folder];
    var tag = s.folder === null ? 'not scored' : !r ? (tops.indexOf(s.folder) !== -1 ? 'not scored' : 'non-standard folder, not scored')
            : r.bonus ? 'bonus' : 'scored';
    var files = s.files.slice().sort(function (a, b) {
      var pa = (a.path || '') + '/' + a.name, pb = (b.path || '') + '/' + b.name;
      return pa.toLowerCase() < pb.toLowerCase() ? -1 : pa.toLowerCase() > pb.toLowerCase() ? 1 : 0;
    });
    total += files.length;
    var g = { folder: s.folder, label: (s.folder === null ? 'Folder root (loose files)' : s.folder) + ' - ' + files.length + ' file' + (files.length === 1 ? '' : 's') + ', ' + tag,
              name: s.folder === null ? 'Folder root (loose files)' : s.folder, url: s.url, total: files.length, rows: [], links: [] };
    files.forEach(function (e) {
      if (listed >= cap) return;
      g.rows.push([(e.path ? e.path + '/' : '') + e.name, fileTypeLabel_(e), fmtDate(e.updated), fileCreditNote_(s.folder, e)]);
      g.links.push({ file: e.url || '', dir: e.path ? (e.dirUrl || '') : '', dirLen: e.path ? e.path.length + 1 : 0 });
      listed++;
    });
    groups.push(g);
  });
  return { groups: groups, listed: listed, total: total, omitted: total - listed };
}

/** Append the "Files in this folder" section to a report body. */
function appendFileListing_(body, invAll, folderUrl) {
  var fmt = function (d) { return d ? Utilities.formatDate(d, CONFIG.TIMEZONE, 'yyyy-MM-dd') : ''; };
  var L = buildFileListing_(invAll.inventory, invAll.rootFiles, CONFIG.REPORT_FILE_LIST_CAP, fmt, folderUrl);
  body.appendParagraph('File directory').setHeading(DocumentApp.ParagraphHeading.HEADING2);
  body.appendParagraph(L.total + ' file' + (L.total === 1 ? '' : 's') + ' found (this report excluded). ' +
    'Folder headings and folder paths link to the folder in Drive; file names link to the file. ' +
    '"Counts" says whether the file earns credit where it sits.').setItalic(true);
  L.groups.forEach(function (g) {
    var h = body.appendParagraph(g.label).setHeading(DocumentApp.ParagraphHeading.HEADING3);
    if (g.url) h.editAsText().setLinkUrl(0, g.name.length - 1, g.url);
    if (!g.total) { body.appendParagraph('(empty)').setItalic(true); return; }
    if (!g.rows.length) { body.appendParagraph('(not listed, file limit reached)').setItalic(true); return; }
    var t = body.appendTable([['File', 'Type', 'Modified', 'Counts']].concat(g.rows));
    t.getRow(0).editAsText().setBold(true);
    g.links.forEach(function (lk, i) {
      var txt = t.getCell(i + 1, 0).editAsText(), end = g.rows[i][0].length - 1;
      if (lk.dir && lk.dirLen > 1) txt.setLinkUrl(0, lk.dirLen - 2, lk.dir);          // "path" (without the trailing slash)
      if (lk.file && end >= lk.dirLen) txt.setLinkUrl(lk.dirLen, end, lk.file);       // file name
    });
    if (g.rows.length < g.total) body.appendParagraph((g.total - g.rows.length) + ' more file(s) in this folder not listed.').setItalic(true);
  });
  if (L.omitted) {
    var p = body.appendParagraph('Listing stopped at ' + L.listed + ' of ' + L.total + ' files. Open the folder to see the rest.');
    p.setItalic(true);
    if (folderUrl) p.setLinkUrl(folderUrl);
  }
}

/** Score one opportunity (Copper record object) and write results back. */
function scoreOpportunity_(opp) {
  var folder = findOppFolder_(opp);
  if (!folder) { logRow_('error', [opp.id, 'score', 'no folder']); return null; }
  var inv = inventoryFolder_(folder);
  var res = computeScore_(inv.inventory, inv.loose);
  try {
    copperUpdateOpportunity_(opp.id, { custom_fields: copperCustomFields_(objOf_(CONFIG.CF_DOC_SCORE, res.score)) });
  } catch (e) { logRow_('error', [opp.id, 'score write-back', String(e)]); }
  try { applyDocumentationGates_(opp, inv.inventory, inv.loose); } catch (e2) { logRow_('error', [opp.id, 'gate after score', String(e2)]); }
  logRow_('score', [opp.id, folder.getName(), res.score, 100, res.breakdown.join(' | ')]);
  return res;
}

function objOf_(k, v) { var o = {}; o[k] = v; return o; }

/** Manual: score a single opportunity by Copper id from the editor. */
function scoreOpportunityById(id) {
  id = id || 38973969;
  var res = scoreOpportunity_(copperGetOpportunity_(id));
  Logger.log(JSON.stringify(res));
}

/** Manual/batch: score every opportunity in Closed Projects or flagged Project Completed that has no score yet. */
function scoreAllCompleted() {
  var opps = copperSearchOpportunities_({});
  var n = 0;
  opps.forEach(function (o) {
    if (shouldScore_(o) && !hasScore_(o)) { scoreOpportunity_(o); n++; }
  });
  Logger.log('Scored ' + n);
}

/* ---------------- Score report documents ---------------- */

/** Human wording of a rubric entry's requirement. */
function rubricExpectation_(name) {
  var r = CONFIG.SCORING[name];
  if (!r) return 'Not scored';
  var parts = ['at least ' + r.minFiles + ' file' + (r.minFiles > 1 ? 's' : '')];
  (r.needTypes || []).forEach(function (group) {
    parts.push('a ' + group.map(function (t) { return CONFIG.TYPE_LABELS[t] || t; }).join(' or '));
  });
  return parts.join(', including ') + (r.bonus ? ' (bonus: adds points, never subtracts)' : '');
}

/** What the inventory found in one folder, in words. */
function foundDescription_(inv) {
  var count = typeof inv === 'number' ? inv : (inv ? inv.count : 0);
  var types = (inv && inv.types) || [];
  if (!count) return 'empty';
  var t = types.filter(function (k) { return CONFIG.TYPE_LABELS[k]; })
               .map(function (k) { return CONFIG.TYPE_LABELS[k]; });
  return count + ' file' + (count > 1 ? 's' : '') + (t.length ? ' (includes: ' + t.join(', ') + ')' : ' (none of the recognised types)');
}

/** Missing-requirement summary for one folder, '' when satisfied. */
function missingSummary_(name, inv) {
  var r = CONFIG.SCORING[name];
  if (!r || r.bonus) return '';
  var count = typeof inv === 'number' ? inv : (inv ? inv.count : 0);
  var types = (inv && inv.types) || [];
  if (!count) return name + ': empty';
  var missing = (r.needTypes || []).filter(function (g) { return !g.some(function (t) { return types.indexOf(t) !== -1; }); });
  if (missing.length) return name + ': no ' + missing.map(function (g) { return g.map(function (t) { return CONFIG.TYPE_LABELS[t] || t; }).join(' or '); }).join(', no ');
  return '';
}

/**
 * Score one opportunity, write the score to Copper, and create a "_FILE DIRECTORY AND SCORING" Google Doc
 * at the folder root (replacing any previous one). Returns {score, docUrl, owner, missing[]}.
 * Runnable any time; the report never changes the score (report docs are excluded from inventory).
 */
function scoreAndReport(oppId, options) {
  options = options || {};
  var opp = typeof oppId === 'object' ? oppId : copperGetOpportunity_(oppId || 38973969);
  var folder = findOppFolder_(opp);
  if (!folder) { logRow_('error', [opp.id, 'report', 'no folder']); return null; }
  if (options.fileBot) fileBotValidateFolder_(folder, String(opp.id));
  var owner = oppOwner_(opp);
  var invAll = inventoryFolder_(folder);
  var res = computeScore_(invAll.inventory, invAll.loose);
  try {
    copperUpdateOpportunity_(opp.id, { custom_fields: copperCustomFields_(objOf_(CONFIG.CF_DOC_SCORE, res.score)) });
  } catch (e) {
    logRow_('error', [opp.id, 'score write-back', String(e)]);
    if (options.fileBot) throw new Error('Copper score update failed; refresh was not completed.');
  }
  try { applyDocumentationGates_(opp, invAll.inventory, invAll.loose); } catch (e2) { logRow_('error', [opp.id, 'gate after report', String(e2)]); }

  // Replace any previous report doc
  if (!options.fileBot) {
    var it = folder.getFiles();
    while (it.hasNext()) { var f = it.next(); if (isReportFile_(f.getName())) f.setTrashed(true); }
  }

  var today = Utilities.formatDate(new Date(), CONFIG.TIMEZONE, 'yyyy-MM-dd');
  var doc = DocumentApp.create(CONFIG.REPORT_PREFIX + ' - ' + res.score + ' of 100 - ' + today);
  var body = doc.getBody();
  body.appendParagraph('File Directory and Scoring').setHeading(DocumentApp.ParagraphHeading.HEADING1);
  body.appendParagraph('Documentation Score: ' + res.score + ' / 100').setHeading(DocumentApp.ParagraphHeading.HEADING2);
  body.appendParagraph(folder.getName()).setLinkUrl(folder.getUrl());
  body.appendParagraph('Owner: ' + owner.name + (owner.email ? ' (' + owner.email + ')' : ''));
  body.appendParagraph('Stage: ' + (stageNameOf_(opp) || '-') + '    Status: ' + opp.status + '    Generated: ' + today);
  var reurl = reportRerunUrl_(opp.id);
  if (reurl) {
    var p = body.appendParagraph('\u21BB  RE-RUN THIS CHECK');
    p.setLinkUrl(reurl).setBold(true);
    body.appendParagraph('Fix the folders below, then click the link above. A new report replaces this one within seconds.').setItalic(true);
  }
  var table = [['Folder', 'Expected', 'Found', 'Points']];
  var missing = [];
  Object.keys(CONFIG.SCORING).forEach(function (name) {
    var r = CONFIG.SCORING[name];
    var inv = invAll.inventory[name];
    var line = res.breakdown.filter(function (b) { return b.indexOf(name + ':') === 0; })[0] || '';
    var pts = String(parseInt(line.split('=')[1], 10) || 0);   // points only; drop the 'b' bonus marker and '(no pdf)' notes
    var expected = (CONFIG.FOLDER_INTENT[name] || '') + ' Required: ' + rubricExpectation_(name) + '.';
    table.push([name, expected, foundDescription_(inv), pts + ' / ' + (r.bonus ? '+' + r.weight : r.weight)]);
    var m = missingSummary_(name, inv);
    if (m) missing.push(m);
  });
  table.push(['07_PRODUCTION', CONFIG.FOLDER_INTENT['07_PRODUCTION'] + ' Not scored.', '-', '-']);
  table.push(['11_PHOTOS', CONFIG.FOLDER_INTENT['11_PHOTOS'] + ' Not scored.', '-', '-']);
  var t = body.appendTable(table);
  t.getRow(0).editAsText().setBold(true);
  for (var ri = 1; ri < table.length; ri++) {
    var sub = invAll.inventory[table[ri][0]];
    if (sub && sub.url) t.getCell(ri, 0).editAsText().setLinkUrl(sub.url);
  }
  if (missing.length) {
    body.appendParagraph('To improve this score').setHeading(DocumentApp.ParagraphHeading.HEADING2);
    missing.forEach(function (m) { body.appendListItem(m); });
  }
  try { appendFileListing_(body, invAll, folder.getUrl()); }
  catch (e) { logRow_('error', [opp.id, 'report file listing', String(e)]); }
  doc.saveAndClose();
  var file = DriveApp.getFileById(doc.getId());
  file.moveTo(folder);
  logRow_('score', [opp.id, folder.getName(), res.score, 100, res.breakdown.join(' | ')]);
  return { score: res.score, reportId: doc.getId(), docUrl: doc.getUrl(), owner: owner, missing: missing, folder: folder };
}

/** Web app URL for the re-run link; '' until WEB_APP_URL is stored in Script Properties after deployment. */
function reportRerunUrl_(oppId) {
  var base = PropertiesService.getScriptProperties().getProperty('WEB_APP_URL');
  return base ? base + '?action=score&id=' + oppId : '';
}

/** Editor helper: score one opportunity and print the report link. */
function reportOne() {
  var r = scoreAndReport(38973969);
  Logger.log(JSON.stringify({ score: r && r.score, doc: r && r.docUrl }));
}

/**
 * Batch: score and report every opportunity whose folder lives in PRODUCTION or CLOSED_PROJECTS.
 * Chunked and resumable like the reconcile. Writes the "Score Report" summary tab as it goes and
 * the "Score by Owner" averages tab at the end.
 */
function scoreReportAll() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(20000)) { scheduleContinuation_('scoreReportAll', 60); return; }
  try { scoreReportChunk_(); } finally { lock.releaseLock(); }
}

function scoreReportChunk_() {
  var props = PropertiesService.getScriptProperties();
  var started = Date.now();
  var BUDGET_MS = 5 * 60 * 1000;
  var state = JSON.parse(props.getProperty('SCORE_RPT_STATE') || 'null');
  if (!state || !state.ids) {
    var all = copperSearchOpportunities_({}).filter(function (o) {
      var b = bucketForOpp_(o);
      return b === 'PRODUCTION' || b === 'CLOSED_PROJECTS';
    });
    reconcileCache_().set(all);
    state = { ids: all.map(function (o) { return o.id; }), next: 0, watchdog: null };
  }
  deleteTriggerById_(state.watchdog);
  state.watchdog = scheduleContinuation_('scoreReportAll', Math.round(BUDGET_MS / 1000) + 120);
  props.setProperty('SCORE_RPT_STATE', JSON.stringify(state));

  var sheet = planSheet_(CONFIG.REPORT_SHEET);
  if (state.next === 0) {
    sheet.clearContents();
    sheet.appendRow(['timestamp', 'opp_id', 'opportunity folder', 'bucket', 'stage', 'owner', 'owner email', 'score', 'missing', 'folder link', 'report link']);
  }
  var rows = [];
  while (state.next < state.ids.length && (Date.now() - started) < BUDGET_MS) {
    var id = state.ids[state.next];
    try {
      var opp = reconcileCache_().get(id) || copperGetOpportunity_(id);
      var r = scoreAndReport(opp);
      if (r) rows.push([new Date(), id, r.folder.getName(), bucketForOpp_(opp), stageNameOf_(opp) || '', r.owner.name, r.owner.email, r.score, r.missing.join('; '), r.folder.getUrl(), r.docUrl]);
      else rows.push([new Date(), id, '(no folder)', bucketForOpp_(opp), '', '', '', '', '', '', '']);
    } catch (e) {
      rows.push([new Date(), id, 'ERROR', '', '', '', '', '', String(e).slice(0, 200), '', '']);
    }
    state.next++;
    if (rows.length >= 20) { appendRows_(sheet, rows); rows = []; props.setProperty('SCORE_RPT_STATE', JSON.stringify(state)); }
  }
  if (rows.length) appendRows_(sheet, rows);

  if (state.next < state.ids.length) {
    deleteTriggerById_(state.watchdog);
    state.watchdog = scheduleContinuation_('scoreReportAll', 60);
    props.setProperty('SCORE_RPT_STATE', JSON.stringify(state));
    Logger.log('Score report paused at ' + state.next + '/' + state.ids.length);
    return;
  }
  deleteTriggerById_(state.watchdog);
  props.deleteProperty('SCORE_RPT_STATE');
  writeOwnerSummary_();
  cleanupScoreTriggers_();
  Logger.log('Score report complete: ' + state.ids.length + ' opportunities.');
}

/** Per-owner averages from the Score Report tab. */
function writeOwnerSummary_() {
  var src = planSheet_(CONFIG.REPORT_SHEET);
  var data = src.getDataRange().getValues();
  var byOwner = {};
  for (var i = 1; i < data.length; i++) {
    var owner = data[i][5] || '(none)';
    var score = data[i][7];
    if (score === '' || score === null) continue;
    (byOwner[owner] = byOwner[owner] || []).push(Number(score));
  }
  var out = planSheet_(CONFIG.REPORT_OWNER_SHEET);
  out.clearContents();
  out.appendRow(['owner', 'opportunities', 'average score', 'min', 'max']);
  Object.keys(byOwner).sort().forEach(function (o) {
    var a = byOwner[o];
    var avg = Math.round(a.reduce(function (x, y) { return x + y; }, 0) / a.length);
    out.appendRow([o, a.length, avg, Math.min.apply(null, a), Math.max.apply(null, a)]);
  });
  try { createOwnerScoreReport(); } catch (e) { logRow_('error', ['-', 'owner report doc', String(e)]); }
}

/**
 * Team-facing "Documentation Scores by Owner" Google Doc at the CRM root, built from the
 * "Score Report" tab. The doc is REWRITTEN IN PLACE each run (id kept in Script Property
 * OWNER_REPORT_DOC_ID), so the circulated link never changes. Also runs automatically at the
 * end of every scoreReportAll batch.
 */
function createOwnerScoreReport() {
  var props = PropertiesService.getScriptProperties();
  var doc;
  var id = props.getProperty('OWNER_REPORT_DOC_ID');
  if (id) { try { doc = DocumentApp.openById(id); } catch (e) { doc = null; } }
  if (!doc) {
    doc = DocumentApp.create('Documentation Scores by Owner');
    DriveApp.getFileById(doc.getId()).moveTo(DriveApp.getFolderById(CONFIG.CRM_SHARED_DRIVE_ID));
    props.setProperty('OWNER_REPORT_DOC_ID', doc.getId());
  }
  var data = planSheet_(CONFIG.REPORT_SHEET).getDataRange().getValues();
  var byOwner = {};
  for (var i = 1; i < data.length; i++) {
    var row = data[i];
    if (row[7] === '' || row[7] === null || row[2] === 'ERROR' || row[2] === '(no folder)') continue;
    var o = row[5] || 'Unassigned';
    (byOwner[o] = byOwner[o] || []).push({ folder: row[2], bucket: row[3], score: Number(row[7]), missing: row[8], link: row[9], report: row[10] });
  }
  var owners = Object.keys(byOwner).sort(function (a, b) {
    var avg = function (o) { var l = byOwner[o]; return l.reduce(function (x, y) { return x + y.score; }, 0) / l.length; };
    return avg(b) - avg(a);
  });
  var today = Utilities.formatDate(new Date(), CONFIG.TIMEZONE, 'yyyy-MM-dd');
  var H1 = DocumentApp.ParagraphHeading.HEADING1, H2 = DocumentApp.ParagraphHeading.HEADING2;
  var b = doc.getBody();
  var marker = b.appendParagraph('');
  while (b.getNumChildren() > 1) b.removeChild(b.getChild(0));
  b.appendParagraph('Documentation Scores by Owner').setHeading(H1);
  b.appendParagraph('Generated ' + today + '. Scores refresh automatically; this document is rewritten on every batch run, so this link is always current.');
  b.appendParagraph('How scoring works: see "How Customer Folders Are Scored" at the root of the CRM drive. ' +
    'Every opportunity folder contains a ' + CONFIG.REPORT_PREFIX + ' doc listing every file and exactly what is missing, with a RE-RUN THIS CHECK link to verify your fixes instantly.');
  var total = 0, count = 0;
  owners.forEach(function (o) { byOwner[o].forEach(function (r) { total += r.score; count++; }); });
  b.appendParagraph('Overall: ' + count + ' opportunities, average score ' + (count ? Math.round(total / count) : 0) + ' / 100.');
  var sum = [['Owner', 'Opportunities', 'Average', 'Min', 'Max']];
  owners.forEach(function (o) {
    var l = byOwner[o].map(function (r) { return r.score; });
    sum.push([o, String(l.length), String(Math.round(l.reduce(function (x, y) { return x + y; }, 0) / l.length)), String(Math.min.apply(null, l)), String(Math.max.apply(null, l))]);
  });
  var st = b.appendTable(sum);
  st.getRow(0).editAsText().setBold(true);
  owners.forEach(function (o) {
    b.appendParagraph(o).setHeading(H2);
    byOwner[o].sort(function (a, c) { return a.score - c.score; }).forEach(function (r) {
      var li = b.appendListItem(r.score + ' / 100  ' + r.folder + (r.missing ? '  (' + String(r.missing).split(';').length + ' items missing)' : ''));
      if (r.link) li.setLinkUrl(String(r.link));
    });
  });
  b.removeChild(marker);
  doc.saveAndClose();
  Logger.log('Owner report: ' + doc.getUrl());
  return doc.getUrl();
}

function cleanupScoreTriggers_() {
  var keep = PropertiesService.getScriptProperties().getProperty('NIGHTLY_SCORE_TRIGGER_ID');
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'scoreReportAll' && t.getUniqueId() !== keep) { try { ScriptApp.deleteTrigger(t); } catch (e) {} }

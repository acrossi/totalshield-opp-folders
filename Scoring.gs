/* ---------------- Tanner legacy-file cleanup ---------------- */

/** Which numbered subfolder a legacy file belongs in; '' = leave in place.
 * CAD of any flavour (Tanner used SketchUp and Fusion, not SolidWorks) goes to 04_MODEL. */
function classifyForMove_(name, mime, parentPath) {
  var n = String(name || '').toLowerCase();
  var p = String(parentPath || '').toLowerCase();
  if (/\.(skp|f3d|f3z|sldprt|sldasm|slddrw|step|stp|igs|iges|stl|dwg|dxf|3dm|easm|eprt|ipt|iam|obj|3ds)$/.test(n)) return '04_MODEL';
  if (/purchase\s*order|(^|[\s_\-#(])p\.?o\.?([\s_\-#).]|$)/.test(n)) return '06_PURCHASE_ORDER';
  if (/invoice|receipt|payment|billing|remit|deposit/.test(n)) return '10_FINANCIALS';
  if (/quote|quotation|estimate|proposal/.test(n)) return '05_QUOTE';
  if (/rfp|rfq|floor\s*plan|floorplan|site\s*plan/.test(n)) return '00_CUSTOMER_DOCS';
  if (/intake|questionnaire/.test(n)) return '01_CLIENT_INTAKE';
  if (/requirement|scope|\bsow\b/.test(n)) return '02_REQUIREMENTS';
  if (/calc|analysis|ballistic|blast|threat/.test(n)) return '03_ANALYSIS';
  if (/^image\//.test(String(mime || ''))) return '11_PHOTOS';
  if (/install/.test(n) || /install/.test(p)) return '09_INSTALLATION';
  if (/deliverable|final\s*report|manual|o&m/.test(n) || /deliverable/.test(p)) return '08_DELIVERABLES';
  if (/cad|model|engineering|drawing/.test(p) && /\.pdf$/.test(n)) return '04_MODEL';
  if (/quote/.test(p)) return '05_QUOTE';
  if (/admin|account|financ/.test(p)) return '10_FINANCIALS';
  if (/research/.test(p)) return '02_REQUIREMENTS';
  if (/production|shop|cnc/.test(p)) return '07_PRODUCTION';
  return '';
}

/** Tanner's unassigned PRODUCTION/CLOSED_PROJECTS opportunities (Historical Owner field). */
function tannerOpps_() {
  return copperSearchOpportunities_({}).filter(function (o) {
    var b = bucketForOpp_(o);
    if (b !== 'PRODUCTION' && b !== 'CLOSED_PROJECTS') return false;
    if (o.assignee_id) return false;
    var hist = '';
    try { hist = String(copperFieldValue_(o, CONFIG.CF_HIST_OWNER) || ''); } catch (e) {}
    return hist.indexOf('Tanner') === 0;
  });
}

/** DRY RUN: list every legacy file in Tanner's folders with its proposed destination in the
 * "Move Plan" tab. Moves nothing. Files already inside numbered folders are not touched. */
function tannerMovePlan() {
  var sheet = planSheet_('Move Plan');
  sheet.clearContents();
  sheet.appendRow(['opp_id', 'opportunity folder', 'file id', 'file name', 'current location', 'destination', 'status']);
  var rows = [];
  tannerOpps_().forEach(function (o) {
    var folder = findOppFolder_(o);
    if (!folder) return;
    collectMoveRows_(folder, folder.getName(), '', o.id, rows);
  });
  for (var i = 0; i < rows.length; i += 40) appendRows_(sheet, rows.slice(i, i + 40));
  var counts = {};
  rows.forEach(function (r) { counts[r[5] || 'LEAVE'] = (counts[r[5] || 'LEAVE'] || 0) + 1; });
  Logger.log(JSON.stringify({ files: rows.length, by_destination: counts }));
}

function collectMoveRows_(folder, rootName, relPath, oppId, rows) {
  var files = folder.getFiles();
  while (files.hasNext()) {
    var f = files.next();
    var name = f.getName();
    if (isReportFile_(name)) continue;
    rows.push([oppId, rootName, f.getId(), name, relPath || '(root)', classifyForMove_(name, f.getMimeType(), relPath), '']);
  }
  var subs = folder.getFolders();
  while (subs.hasNext()) {
    var sf = subs.next();
    var sn = sf.getName();
    if (/^\d\d_/.test(sn)) continue;
    collectMoveRows_(sf, rootName, relPath ? relPath + '/' + sn : sn, oppId, rows);
  }
}

function folderByName_(name) {
  var it = DriveApp.getFoldersByName(name);
  return it.hasNext() ? it.next() : null;
}

/** EXECUTE the "Move Plan": move every row that has a destination and no status yet.
 * Time-boxed and rerunnable; run again if it logs that it paused. */
function tannerMoveExecute() {
  var sheet = planSheet_('Move Plan');
  var data = sheet.getDataRange().getValues();
  var started = Date.now(), moved = 0, errs = 0, roots = {}, dests = {};
  var status = data.map(function (row) { return [row[6]]; });
  function saveStatus_() {
    if (data.length > 1) sheet.getRange(2, 7, data.length - 1, 1).setValues(status.slice(1));
    SpreadsheetApp.flush();
  }
  for (var r = 1; r < data.length; r++) {
    if (!data[r][5] || data[r][6]) continue;
    if (Date.now() - started > 4.5 * 60 * 1000) {
      saveStatus_();
      cleanupMoveTriggers_();
      scheduleContinuation_('tannerMoveExecute', 60);
      Logger.log('Paused after ' + moved + ' moves; continuing automatically in 60s.');
      return;
    }
    try {
      var rootName = String(data[r][1]);
      var root = roots[rootName] || (roots[rootName] = folderByName_(rootName));
      if (!root) throw new Error('opportunity folder not found');
      var key = rootName + '|' + data[r][5];
      var dest = dests[key] || (dests[key] = childFolderByName_(root, String(data[r][5])) || root.createFolder(String(data[r][5])));
      DriveApp.getFileById(String(data[r][2])).moveTo(dest);
      status[r] = ['MOVED']; moved++;
    } catch (e) { status[r] = ['ERROR: ' + String(e).slice(0, 120)]; errs++; }
  }
  saveStatus_();
  cleanupMoveTriggers_();
  Logger.log('Moves complete this run: ' + moved + ' moved, ' + errs + ' errors. Nothing left to move.');
}

function cleanupMoveTriggers_() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'tannerMoveExecute') { try { ScriptApp.deleteTrigger(t); } catch (e) {} }
  });
}

/** Diagnostic: completed/closed records missing OID, Drive link or root id in Copper. Read-only. */
function auditMissingCopperFields() {
  var opps = copperSearchOpportunities_({});
  var pop = opps.filter(function (o) { return shouldScore_(o); });
  var missing = [];
  pop.forEach(function (o) {
    var oid = copperFieldValue_(o, CONFIG.CF_OPP_ID);
    var link = copperFieldValue_(o, CONFIG.CF_DRIVE_LINK);
    var root = copperFieldValue_(o, CONFIG.CF_DRIVE_ROOT_ID);
    if (!oid || !link || !root) missing.push([o.id, o.status, stageNameOf_(o) || '', !!oid, !!link, !!root, String(o.name || '').slice(0, 40)].join('|'));
  });
  Logger.log('completed population: ' + pop.length + '; records missing a field: ' + missing.length);
  Logger.log(missing.slice(0, 25).join('\n'));
}

